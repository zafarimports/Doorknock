<?xml version="1.0" encoding="utf-8"?>
<!-- Voter names, addresses and doorstep notes stay on the device they were
     recorded on. Use the app's own export if you need a copy. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
    </device-transfer>
</data-extraction-rules>
